{
  "name": "silvia-keel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "shield": "tsx apps/cli/src/main.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm shield tactics lint && pnpm shield eval --provider none --out eval-report.md --gate"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.20.5",
    "eslint": "9.39.4",
    "prettier": "3.9.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
